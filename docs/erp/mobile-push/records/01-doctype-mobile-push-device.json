{
  "doctype": "DocType",
  "name": "Mobile Push Device",
  "module": "Custom",
  "custom": 1,
  "autoname": "hash",
  "track_changes": 0,
  "sort_field": "last_seen",
  "sort_order": "DESC",
  "title_field": "user",
  "description": "A phone that receives Multimax push notifications (Firebase Cloud Messaging). Rows are written only through the mobile_push_register / mobile_push_unregister API methods.",
  "fields": [
    {"fieldname": "user", "label": "User", "fieldtype": "Link", "options": "User", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1},
    {"fieldname": "enabled", "label": "Enabled", "fieldtype": "Check", "default": "1", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "platform", "label": "Platform", "fieldtype": "Select", "options": "android\nios", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "app_id", "label": "App ID", "fieldtype": "Data", "in_list_view": 1, "description": "Package or bundle id, e.g. com.ddmco.multimax or com.ddmco.multimax.smoke"},
    {"fieldname": "app_version", "label": "App Version", "fieldtype": "Data"},
    {"fieldname": "device_model", "label": "Device Model", "fieldtype": "Data"},
    {"fieldname": "column_break_status", "fieldtype": "Column Break"},
    {"fieldname": "last_seen", "label": "Last Seen", "fieldtype": "Datetime", "read_only": 1, "in_list_view": 1},
    {"fieldname": "last_error", "label": "Last Error", "fieldtype": "Small Text", "read_only": 1, "description": "Set by the sender when FCM rejects the token"},
    {"fieldname": "section_token", "fieldtype": "Section Break", "label": "Token", "collapsible": 1},
    {"fieldname": "token", "label": "FCM Token", "fieldtype": "Data", "length": 255, "reqd": 1, "unique": 1, "read_only": 1}
  ],
  "permissions": [
    {"role": "System Manager", "permlevel": 0, "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 0, "email": 0, "share": 0}
  ]
}
